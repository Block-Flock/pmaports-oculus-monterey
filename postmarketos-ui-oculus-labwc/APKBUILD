# Reference: https://postmarketos.org/uipkg
pkgname=postmarketos-ui-oculus-labwc
pkgver=1
pkgrel=3
pkgdesc="Recoverable labwc desktop and nested KWin VR launcher for Oculus Quest 1"
url="https://github.com/un-simp/pmaports-oculus-monterey"
arch="aarch64"
license="GPL-3.0-or-later"
subpackages="$pkgname-openrc"
install="
	$pkgname-openrc.post-install
	$pkgname-openrc.post-upgrade
	"
depends="
	dbus
	device-oculus-monterey
	font-dejavu
	gtklock-oculus-pattern
	kwin-oculus-monterey
	labwc
	monado-oculus-monterey
	postmarketos-base-ui
	tinydm
	xf86-video-fbdev
	xinit
	xorg-server
	"
_pmb_recommends="
	foot
	xwayland
	"
source="
	oculus-labwc-session
	oculus-labwc-xinit
	oculus-vr
	oculus-vr-run
	oculus-labwc.desktop
	xorg-oculus-fbdev.conf
	labwc-autostart
	labwc-environment
	labwc-menu.xml
	labwc-rc.xml
	"
options="!check pmb:default-openrc pmb:support-openrc"

package() {
	install -Dm755 "$srcdir"/oculus-labwc-session \
		"$pkgdir"/usr/bin/oculus-labwc-session
	install -Dm755 "$srcdir"/oculus-vr \
		"$pkgdir"/usr/bin/oculus-vr
	install -Dm755 "$srcdir"/oculus-vr-run \
		"$pkgdir"/usr/bin/oculus-vr-run
	install -Dm755 "$srcdir"/oculus-labwc-xinit \
		"$pkgdir"/usr/libexec/oculus-labwc-xinit

	install -Dm644 "$srcdir"/oculus-labwc.desktop \
		"$pkgdir"/usr/share/wayland-sessions/oculus-labwc.desktop
	install -Dm644 "$srcdir"/xorg-oculus-fbdev.conf \
		"$pkgdir"/etc/X11/xorg.conf.d/20-oculus-fbdev.conf
	install -Dm755 "$srcdir"/labwc-autostart \
		"$pkgdir"/etc/xdg/oculus-labwc/autostart
	install -Dm644 "$srcdir"/labwc-environment \
		"$pkgdir"/etc/xdg/oculus-labwc/environment
	install -Dm644 "$srcdir"/labwc-menu.xml \
		"$pkgdir"/etc/xdg/oculus-labwc/menu.xml
	install -Dm644 "$srcdir"/labwc-rc.xml \
		"$pkgdir"/etc/xdg/oculus-labwc/rc.xml
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	depends="
		dbus-openrc
		openrc
		tinydm-openrc
		"

	mkdir -p "$subpkgdir"
}

