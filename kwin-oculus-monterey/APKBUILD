_commit=ad20b0ea6f9ec415cb3756f1d53ce419548fe6bf
source="$pkgname-$_commit.tar.gz::https://github.com/Block-Flock/kwin-oculus-monterey/archive/$_commit.tar.gz"
builddir="$srcdir/$pkgname-$_commit"
options="!check"

build() {
	CFLAGS="$CFLAGS -O2 -g1" CXXFLAGS="$CXXFLAGS -O2 -g1" \
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_TESTING=OFF \
		-DKWIN_BUILD_VR=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

