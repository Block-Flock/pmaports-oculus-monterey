# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: config.gz dumped from device
maintainer=""
pkgname=linux-oculus-monterey
pkgver=4.4.205
pkgrel=3
_commit=6929f734ce0e602018790ff3a52dc7bad646af60
pkgdesc="Oculus Quest 1 kernel fork"
arch="aarch64"
url="https://kernel.org"
license="GPL-2.0-only"
makedepends="
	bash
	bc
	bison
	devicepkg-dev
	flex
	gcc4
	openssl-dev
	perl
	"
source="
	$pkgname-$_commit.tar.gz::https://github.com/facebookincubator/oculus-linux-kernel/archive/$_commit.tar.gz
	config-${pkgname#linux-}.$arch
	90hz-default-v2.patch
	honor-pmos-initramfs.patch
	drop-missing-internal-kconfig.patch
	fix-dtc-yylloc.patch
	fix-old-dtc-warning-flags.patch
	"
builddir="$srcdir/oculus-linux-kernel-$_commit"
options="
	!check
	!strip
	!tracedeps
	pmb:cross-native
	"
_outdir="out"
_config="config-${pkgname#linux-}.$arch"

_carch="arm64"

# This downstream 4.4 tree was built by Oculus with GCC 4.9.  Kernels built
# with current GCC reach neither initramfs nor a usable debug transport on the
# Quest 1, while the stock GCC 4.9 kernel does.  Use pmaports' maintained GCC 4
# cross-toolchain, as done by other old downstream kernel packages.
if [ "${CC:0:5}" != "gcc4-" ]; then
	CC="gcc4-$CC"
	HOSTCC="gcc4-gcc"
	CROSS_COMPILE="gcc4-$CROSS_COMPILE"
fi

# Used internally by pmbootstrap. Don't touch.
# TODO: Remove once minimum default pmbootstrap version supports
# kernel packages without '_flavor'.
_flavor="${pkgname#linux-}"

prepare() {
	default_prepare
	sed -i '/^obj-y[[:space:]]*+=[[:space:]]*internal\/$/d' \
		drivers/staging/oculus/Makefile
	. downstreamkernel_prepare
}

build() {
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))"-postmarketOS
}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"${pkgname#linux-}" "$_outdir"
}

sha512sums="
