# Reference: <https://postmarketos.org/devicepkg>
maintainer=""
pkgname=device-oculus-monterey
pkgver=1
pkgrel=21
pkgdesc="Oculus Quest 1"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
depends="
	android-tools-mkbootimg
	device-mapper
	libqipcrtr4msmipc
	linux-oculus-monterey
	postmarketos-base
	postmarketos-base-downstream
	rmtfs
	sudo-rs
	unudhcpd
	"
makedepends="
	devicepkg-dev
	linux-headers
	"
source="
	deviceinfo
	modules-initfs
	oculus-initramfs-debug-login
	oculus-map-pmos-subpartitions
	oculus-mdev.initd
	oculus-initramfs-recovery-cleanup
	oculus-initramfs-recovery-hook
	oculus-initramfs-recovery.files
	oculus-controller
	oculus-controller-input
	oculus-controller-uinput.c
	oculus-controller.initd
	oculus-reboot-bootloader.c
	oculus-syncboss-dump.c
	oculus-recovery.sudoers
	oculus-refresh-rate
	oculus-rmtfs
	oculus-rmtfs.initd
	oculus-stock-firmware
	oculus-stock-firmware.initd
	oculus-usb-recovery
	oculus-usb-recovery.initd
	oculus-usb-recovery.nmconf
	"
options="!archcheck !check"

build() {
	devicepkg_build $startdir $pkgname
	$CC $CPPFLAGS $CFLAGS -static $LDFLAGS \
		-o oculus-reboot-bootloader "$srcdir/oculus-reboot-bootloader.c"
	$CC $CPPFLAGS $CFLAGS $LDFLAGS \
		-o oculus-syncboss-dump "$srcdir/oculus-syncboss-dump.c"
	$CC $CPPFLAGS $CFLAGS $LDFLAGS \
		-o oculus-controller-uinput "$srcdir/oculus-controller-uinput.c" -lm
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir/oculus-refresh-rate" \
		"$pkgdir/usr/sbin/oculus-refresh-rate"
	install -Dm755 "$srcdir/oculus-controller" \
		"$pkgdir/usr/sbin/oculus-controller"
	install -Dm755 "$srcdir/oculus-controller-input" \
		"$pkgdir/usr/sbin/oculus-controller-input"
	install -Dm755 oculus-controller-uinput \
		"$pkgdir/usr/sbin/oculus-controller-uinput"
	install -Dm755 "$srcdir/oculus-controller.initd" \
		"$pkgdir/etc/init.d/oculus-controller"
	install -Dm755 oculus-reboot-bootloader \
		"$pkgdir/usr/sbin/oculus-reboot-bootloader"
	install -Dm755 oculus-syncboss-dump \
		"$pkgdir/usr/sbin/oculus-syncboss-dump"
	install -Dm755 "$srcdir/oculus-usb-recovery" \
		"$pkgdir/usr/sbin/oculus-usb-recovery"
	install -Dm755 "$srcdir/oculus-rmtfs" \
		"$pkgdir/usr/sbin/oculus-rmtfs"
	install -Dm755 "$srcdir/oculus-rmtfs.initd" \
		"$pkgdir/etc/init.d/oculus-rmtfs"
	install -Dm755 "$srcdir/oculus-stock-firmware" \
		"$pkgdir/usr/sbin/oculus-stock-firmware"
	install -Dm755 "$srcdir/oculus-stock-firmware.initd" \
		"$pkgdir/etc/init.d/oculus-stock-firmware"
	install -Dm755 "$srcdir/oculus-usb-recovery.initd" \
		"$pkgdir/etc/init.d/oculus-usb-recovery"
	install -Dm755 "$srcdir/oculus-mdev.initd" \
		"$pkgdir/etc/init.d/oculus-mdev"
	install -Dm644 "$srcdir/oculus-usb-recovery.nmconf" \
		"$pkgdir/etc/NetworkManager/conf.d/20-oculus-usb-recovery.conf"
	install -Dm440 "$srcdir/oculus-recovery.sudoers" \
		"$pkgdir/etc/sudoers.d/oculus-recovery"
	install -Dm755 "$srcdir/oculus-initramfs-recovery-hook" \
		"$pkgdir/usr/share/mkinitfs/hooks/20-oculus-recovery.sh"
	install -Dm755 "$srcdir/oculus-initramfs-debug-login" \
		"$pkgdir/usr/share/oculus-monterey/oculus-initramfs-debug-login"
	install -Dm755 "$srcdir/oculus-map-pmos-subpartitions" \
		"$pkgdir/usr/share/oculus-monterey/oculus-map-pmos-subpartitions"
	install -Dm755 "$srcdir/oculus-initramfs-recovery-cleanup" \
		"$pkgdir/usr/share/mkinitfs/hooks-cleanup/80-oculus-recovery.sh"
	install -Dm644 "$srcdir/oculus-initramfs-recovery.files" \
		"$pkgdir/usr/share/mkinitfs/files/20-oculus-recovery.files"
	mkdir -p "$pkgdir/etc/runlevels/default"
	ln -s /etc/init.d/oculus-stock-firmware \
		"$pkgdir/etc/runlevels/default/oculus-stock-firmware"
	ln -s /etc/init.d/oculus-rmtfs \
		"$pkgdir/etc/runlevels/default/oculus-rmtfs"
	ln -s /etc/init.d/oculus-usb-recovery \
		"$pkgdir/etc/runlevels/default/oculus-usb-recovery"
	mkdir -p "$pkgdir/etc/runlevels/sysinit"
	ln -s /etc/init.d/oculus-mdev \
		"$pkgdir/etc/runlevels/sysinit/oculus-mdev"
}

