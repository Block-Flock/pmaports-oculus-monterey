#!/bin/sh

# Keep the initramfs-created NCM gadget reachable after switch_root. OpenRC's
# supervise-daemon restarts this program if USB temporarily disconnects.
set -eu

configfs=${OCULUS_CONFIGFS:-/sys/kernel/config/usb_gadget/g1}
net_class=${OCULUS_NET_CLASS:-/sys/class/net}
ip_command=${OCULUS_IP_COMMAND:-ip}
dhcpd=${OCULUS_DHCPD:-/usr/bin/unudhcpd}
while :; do
	interface=
	for function in ncm.usb0 rndis.usb0; do
		if [ -r "$configfs/functions/$function/ifname" ]; then
			interface=$(cat "$configfs/functions/$function/ifname")
			break
		fi
	done
	if [ -n "$interface" ] && [ -d "$net_class/$interface" ]; then
		"$ip_command" link set "$interface" up
		"$ip_command" address replace 172.16.42.1/24 dev "$interface"
		exec "$dhcpd" -i "$interface" \
			-s 172.16.42.1 -c 172.16.42.2
	fi
	sleep 1
done
