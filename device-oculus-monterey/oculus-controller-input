#!/bin/sh
# Keep the stock tool as the SyncBoss owner and attach read-only stream clients
# for at most two connected/paired controller IDs.
set -eu

controller=${OCULUS_CONTROLLER_COMMAND:-/usr/sbin/oculus-controller}
bridge=${OCULUS_CONTROLLER_BRIDGE:-/usr/sbin/oculus-controller-uinput}
interval=${OCULUS_CONTROLLER_RESCAN_SECONDS:-2}
start_delay=${OCULUS_CONTROLLER_START_DELAY:-1}
once=false
case "${1:-}" in
	'') ;;
	--once) once=true ;;
	*) echo "usage: oculus-controller-input [--once]" >&2; exit 2 ;;
esac

owner_pid=
slot1_id=
slot1_pid=
slot2_id=
slot2_pid=

cleanup() {
	for pid in "$slot1_pid" "$slot2_pid" "$owner_pid"; do
		[ -z "$pid" ] || kill "$pid" 2>/dev/null || true
	done
	wait 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

stream_controller() {
	id=$1
	"$controller" stream "$id" | "$bridge"
}

start_slot() {
	id=$1
	stream_controller "$id" &
	new_pid=$!
}

slot_alive() {
	pid=$1
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

"$controller" daemon &
owner_pid=$!
sleep "$start_delay"

while kill -0 "$owner_pid" 2>/dev/null; do
	ids=$("$controller" list 2>/dev/null | awk '
		$1 ~ /^[0-9]+:$/ && $2 ~ /^[[:xdigit:]]{16}$/ { print "0x" $2 }
	' | sed -n '1,2p') || ids=

	if ! slot_alive "$slot1_pid"; then
		slot1_id=
		slot1_pid=
	fi
	if ! slot_alive "$slot2_pid"; then
		slot2_id=
		slot2_pid=
	fi

	for id in $ids; do
		[ "$id" = "$slot1_id" ] && continue
		[ "$id" = "$slot2_id" ] && continue
		if [ -z "$slot1_pid" ]; then
			slot1_id=$id
			start_slot "$id"
			slot1_pid=$new_pid
		elif [ -z "$slot2_pid" ]; then
			slot2_id=$id
			start_slot "$id"
			slot2_pid=$new_pid
		fi
	done
	if $once; then
		# Give the two stream children time to open their read-only observers;
		# cleanup below then terminates the persistent owner and any live bridge.
		sleep 1
		exit 0
	fi
	sleep "$interval"
done

wait "$owner_pid"
