#!/bin/sh
# Keep the stock tool as the SyncBoss owner and attach read-only stream clients
# for at most two connected/paired controller IDs.
set -eu

controller=${OCULUS_CONTROLLER_COMMAND:-/usr/sbin/oculus-controller}
bridge=${OCULUS_CONTROLLER_BRIDGE:-/usr/sbin/oculus-controller-uinput}
interval=${OCULUS_CONTROLLER_RESCAN_SECONDS:-2}
start_delay=${OCULUS_CONTROLLER_START_DELAY:-1}
runtime_dir=${OCULUS_CONTROLLER_RUNTIME_DIR:-/run}
metadata_command=${OCULUS_INPUT_METADATA_COMMAND-udevadm}
once=false
case "${1:-}" in
	'') ;;
	--once) once=true ;;
	*) echo "usage: oculus-controller-input [--once]" >&2; exit 2 ;;
esac

owner_pid=
slot1_id=
slot1_pid=
slot2_id=
slot2_pid=

cleanup() {
	for pid in "$slot1_pid" "$slot2_pid" "$owner_pid"; do
		[ -z "$pid" ] || kill -TERM "$pid" 2>/dev/null || true
	done
	# Stream workers use a one-second grace period of their own. Give their
	# traps time to reap both sides of the FIFO before applying the fallback.
	sleep 2
	for pid in "$slot1_pid" "$slot2_pid" "$owner_pid"; do
		[ -z "$pid" ] || kill -KILL "$pid" 2>/dev/null || true
	done
	wait 2>/dev/null || true
	for id in "$slot1_id" "$slot2_id"; do
		[ -z "$id" ] || rm -f "$runtime_dir/oculus-controller-${id#0x}-$$.fifo"
	done
}

handle_signal() {
	trap - EXIT HUP INT TERM
	cleanup
	exit 0
}
trap cleanup EXIT
trap handle_signal HUP INT TERM

register_uinput_metadata() {
	[ -n "$metadata_command" ] || return 0
	command -v "$metadata_command" >/dev/null 2>&1 || return 0
	found=false
	for name_file in /sys/class/input/event*/device/name; do
		[ -r "$name_file" ] || continue
		[ "$(cat "$name_file")" = "Oculus Touch desktop pointer" ] || continue
		event_path=${name_file%/device/name}
		"$metadata_command" test --action=add "$event_path" >/dev/null 2>&1 || continue
		found=true
	done
	$found
}

stream_controller() {
	id=$1
	fifo=$runtime_dir/oculus-controller-${id#0x}-$$.fifo
	producer_pid=
	consumer_pid=
	stream_cleanup() {
		for child in "$producer_pid" "$consumer_pid"; do
			[ -z "$child" ] || kill -TERM "$child" 2>/dev/null || true
		done
		sleep 1
		for child in "$producer_pid" "$consumer_pid"; do
			[ -z "$child" ] || kill -KILL "$child" 2>/dev/null || true
		done
		for child in "$producer_pid" "$consumer_pid"; do
			[ -z "$child" ] || wait "$child" 2>/dev/null || true
		done
		rm -f "$fifo"
	}
	stream_signal() {
		trap - EXIT HUP INT TERM
		stream_cleanup
		exit 0
	}
	trap stream_cleanup EXIT
	trap stream_signal HUP INT TERM
	umask 077
	rm -f "$fifo"
	mkfifo "$fifo"
	"$controller" stream "$id" >"$fifo" &
	producer_pid=$!
	"$bridge" <"$fifo" &
	consumer_pid=$!
	# mdev creates nodes on the devtmpfs-less stock kernel, but libinput still
	# consumes the udev database. Process the standard input rules synchronously
	# so the desktop can enumerate this device without a running udev daemon.
	register_uinput_metadata || true
	# The consumer sees EOF when the producer exits, while a consumer setup
	# failure must tear down a still-running stock stream. Waiting for the
	# consumer handles both cases and prevents silent uinput failures.
	if wait "$consumer_pid"; then
		result=0
	else
		result=$?
	fi
	stream_cleanup
	producer_pid=
	consumer_pid=
	trap - EXIT HUP INT TERM
	return "$result"
}

start_slot() {
	id=$1
	stream_controller "$id" &
	new_pid=$!
}

slot_alive() {
	pid=$1
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

"$controller" daemon &
owner_pid=$!
sleep "$start_delay"

while kill -0 "$owner_pid" 2>/dev/null; do
	ids=$("$controller" list 2>/dev/null | awk '
		$1 ~ /^[0-9]+:$/ && $2 ~ /^[[:xdigit:]]{16}$/ { print "0x" $2 }
	' | sed -n '1,2p') || ids=

	if ! slot_alive "$slot1_pid"; then
		slot1_id=
		slot1_pid=
	fi
	if ! slot_alive "$slot2_pid"; then
		slot2_id=
		slot2_pid=
	fi

	for id in $ids; do
		[ "$id" = "$slot1_id" ] && continue
		[ "$id" = "$slot2_id" ] && continue
		if [ -z "$slot1_pid" ]; then
			slot1_id=$id
			start_slot "$id"
			slot1_pid=$new_pid
		elif [ -z "$slot2_pid" ]; then
			slot2_id=$id
			start_slot "$id"
			slot2_pid=$new_pid
		fi
	done
	if $once; then
		# Give the two stream children time to open their read-only observers;
		# cleanup below then terminates the persistent owner and any live bridge.
		sleep 1
		exit 0
	fi
	sleep "$interval"
done

wait "$owner_pid"
