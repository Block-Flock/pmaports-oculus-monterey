#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034

name="Oculus Touch desktop input bridge"
description="Keep SyncBoss active and expose paired Touch controls through uinput"
command=/usr/sbin/oculus-controller-input
command_background=true
pidfile=/run/oculus-controller.pid
output_log=/var/log/oculus-controller.log
error_log=/var/log/oculus-controller.log

depend() {
	need oculus-stock-firmware
	after oculus-mdev
}
