#!/bin/sh
set -eu

enabled=/etc/oculus-monterey/pattern-login.enabled

if [ "$(id -u)" -ne 0 ]; then
	echo "Run with sudo: sudo oculus-pattern-setup enable|disable" >&2
	exit 1
fi

case "${1:-}" in
	enable)
		[ -t 0 ] || { echo "Pattern setup requires an interactive terminal" >&2; exit 1; }
		printf 'Draw the pattern as 4-9 unique digits (1-9): '
		trap 'stty echo' 0 1 2 15
		stty -echo
		IFS= read -r first
		stty echo
		printf '\nRepeat the pattern: '
		stty -echo
		IFS= read -r second
		stty echo
		trap - 0 1 2 15
		printf '\n'
		first_normalized=$(printf '%s\n' "$first" | /usr/libexec/oculus-pattern-normalize) || {
			echo "Pattern must resolve to 4-9 dots numbered 1-9" >&2; exit 1;
		}
		second_normalized=$(printf '%s\n' "$second" | /usr/libexec/oculus-pattern-normalize) || {
			echo "Pattern must resolve to 4-9 dots numbered 1-9" >&2; exit 1;
		}
		[ "$first_normalized" = "$second_normalized" ] || {
			echo "Patterns do not match" >&2; exit 1;
		}
		printf 'user:%s\n' "$first_normalized" | chpasswd
		install -d -m755 /etc/oculus-monterey
		: >"$enabled"
		chmod 644 "$enabled"
		unset first second first_normalized second_normalized
		echo "Pattern login enabled for user"
		;;
	disable)
		[ ! -e "$enabled" ] || unlink "$enabled"
		echo "Pattern login disabled; the current Unix password is unchanged"
		;;
	*)
		echo "Usage: oculus-pattern-setup enable|disable" >&2
		exit 2
		;;
esac
