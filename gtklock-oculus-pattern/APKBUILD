pkgname=gtklock-oculus-pattern
pkgver=0.1.0
pkgrel=0
pkgdesc="Controller-friendly pattern module for the Oculus Monterey lock screen"
url="https://github.com/un-simp/pmaports-oculus-monterey"
arch="aarch64"
license="GPL-3.0-or-later AND MIT"
depends="gtklock sudo-rs"
makedepends="gtk+3.0-dev"
source="
	gtklock-module.h
	oculus-pattern-core.c
	oculus-pattern-core.h
	oculus-pattern-module.c
	oculus-pattern-normalize.c
	oculus-pattern-lock
	oculus-pattern-setup
	oculus-pattern.css
	"
options="!check"

build() {
	$CC $CPPFLAGS $CFLAGS -fPIC -shared $LDFLAGS \
		$(pkg-config --cflags --libs gtk+-3.0 gmodule-2.0) \
		-o gtklock-oculus-pattern.so \
		"$srcdir"/oculus-pattern-module.c \
		"$srcdir"/oculus-pattern-core.c
	$CC $CPPFLAGS $CFLAGS $LDFLAGS \
		-o oculus-pattern-normalize \
		"$srcdir"/oculus-pattern-normalize.c \
		"$srcdir"/oculus-pattern-core.c
}

package() {
	install -Dm755 gtklock-oculus-pattern.so \
		"$pkgdir"/usr/lib/gtklock/gtklock-oculus-pattern.so
	install -Dm755 "$srcdir"/oculus-pattern-lock \
		"$pkgdir"/usr/bin/oculus-pattern-lock
	install -Dm755 "$srcdir"/oculus-pattern-setup \
		"$pkgdir"/usr/sbin/oculus-pattern-setup
	install -Dm755 oculus-pattern-normalize \
		"$pkgdir"/usr/libexec/oculus-pattern-normalize
	install -Dm644 "$srcdir"/oculus-pattern.css \
		"$pkgdir"/usr/share/oculus-monterey/pattern-lock.css
}

